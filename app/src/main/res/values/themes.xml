<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── App theme ── -->
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_equals</item>
        <item name="colorPrimaryVariant">#005BA0</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
    </style>

    <!-- ── Base calculator button ── -->
    <style name="CalcBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Number keys: dark gray -->
    <style name="CalcBtn.Number">
        <item name="android:background">@drawable/btn_bg_number</item>
    </style>

    <!-- Special keys (C, CE, ⌫, %): medium gray -->
    <style name="CalcBtn.Special">
        <item name="android:background">@drawable/btn_bg_special</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Operator keys (+, −, ×, ÷): same gray, blue-tinted text -->
    <style name="CalcBtn.Operator">
        <item name="android:background">@drawable/btn_bg_operator</item>
        <item name="android:textColor">@color/text_operator</item>
        <item name="android:textSize">26sp</item>
    </style>

    <!-- Equals key: Windows blue -->
    <style name="CalcBtn.Equals">
        <item name="android:background">@drawable/btn_bg_equals</item>
        <item name="android:textSize">26sp</item>
    </style>

</resources>