<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ── Display area ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:singleLine="true"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/tv_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="64sp"
            android:fontFamily="sans-serif-light"
            android:singleLine="true"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="32sp"
            app:autoSizeMaxTextSize="64sp" />

    </LinearLayout>

    <!-- BUTTON GRID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:orientation="vertical">

        <!-- ROW 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_percent"   style="@style/CalcBtn.Special"   android:text="%" />
            <Button android:id="@+id/btn_ce"        style="@style/CalcBtn.Special"   android:text="CE" />
            <Button android:id="@+id/btn_clear"     style="@style/CalcBtn.Special"   android:text="C" />
            <Button android:id="@+id/btn_backspace" style="@style/CalcBtn.Special"   android:text="⌫" />
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_7"      style="@style/CalcBtn.Number"   android:text="7" />
            <Button android:id="@+id/btn_8"      style="@style/CalcBtn.Number"   android:text="8" />
            <Button android:id="@+id/btn_9"      style="@style/CalcBtn.Number"   android:text="9" />
            <Button android:id="@+id/btn_divide" style="@style/CalcBtn.Operator" android:text="÷" />
        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_4"        style="@style/CalcBtn.Number"   android:text="4" />
            <Button android:id="@+id/btn_5"        style="@style/CalcBtn.Number"   android:text="5" />
            <Button android:id="@+id/btn_6"        style="@style/CalcBtn.Number"   android:text="6" />
            <Button android:id="@+id/btn_multiply" style="@style/CalcBtn.Operator" android:text="×" />
        </LinearLayout>

        <!-- ROW 4 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_1"        style="@style/CalcBtn.Number"   android:text="1" />
            <Button android:id="@+id/btn_2"        style="@style/CalcBtn.Number"   android:text="2" />
            <Button android:id="@+id/btn_3"        style="@style/CalcBtn.Number"   android:text="3" />
            <Button android:id="@+id/btn_subtract" style="@style/CalcBtn.Operator" android:text="−" />
        </LinearLayout>

        <!-- ROW 5 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_negate"  style="@style/CalcBtn.Special"   android:text="+/−" />
            <Button android:id="@+id/btn_0"       style="@style/CalcBtn.Number"    android:text="0" />
            <Button android:id="@+id/btn_decimal" style="@style/CalcBtn.Number"    android:text="." />
            <Button android:id="@+id/btn_add"     style="@style/CalcBtn.Operator"  android:text="+" />
        </LinearLayout>

        <!-- ROW 6 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1.2" android:orientation="horizontal">
            <Button
                android:id="@+id/btn_equals"
                style="@style/CalcBtn.Equals"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="=" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>