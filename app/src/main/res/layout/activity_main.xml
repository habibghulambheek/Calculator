<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <!-- Top Utility Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="16dp"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btn_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
            android:contentDescription="@string/history_desc"
            app:tint="@color/text_secondary" />
        <ImageButton
            android:id="@+id/btn_currency"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_currency"
            android:contentDescription="@string/currency_desc"
            app:tint="@color/text_secondary" />
        <ImageButton
            android:id="@+id/btn_unit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_unit_converter"
            android:contentDescription="@string/unit_converter_desc"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Display area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/et_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="textNoSuggestions"
            android:textColor="@color/text_secondary"
            android:textSize="24sp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:gravity="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="textNoSuggestions"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="72sp"
            android:fontFamily="sans-serif-light"
            android:singleLine="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp" />

    <!-- Button Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp">

        <Button android:id="@+id/btn_clear"     style="@style/CalcBtn.TextOnly" android:text="@string/clear_label"   android:textColor="@color/color_clear" />
        <Button android:id="@+id/btn_percent"   style="@style/CalcBtn.TextOnly" android:text="@string/percent_label"   android:textColor="@color/color_operator" />
        <ImageButton android:id="@+id/btn_backspace" style="@style/CalcBtn.Icon" android:src="@drawable/ic_backspace" app:tint="@color/color_operator" android:contentDescription="@string/backspace_desc" />
        <Button android:id="@+id/btn_divide"    style="@style/CalcBtn.TextOnly" android:text="@string/divide_label"   android:textColor="@color/color_operator" />

        <Button android:id="@+id/btn_7"         style="@style/CalcBtn.TextOnly" android:text="7" />
        <Button android:id="@+id/btn_8"         style="@style/CalcBtn.TextOnly" android:text="8" />
        <Button android:id="@+id/btn_9"         style="@style/CalcBtn.TextOnly" android:text="9" />
        <Button android:id="@+id/btn_multiply"  style="@style/CalcBtn.TextOnly" android:text="@string/multiply_label"   android:textColor="@color/color_operator" />

        <Button android:id="@+id/btn_4"         style="@style/CalcBtn.TextOnly" android:text="4" />
        <Button android:id="@+id/btn_5"         style="@style/CalcBtn.TextOnly" android:text="5" />
        <Button android:id="@+id/btn_6"         style="@style/CalcBtn.TextOnly" android:text="6" />
        <Button android:id="@+id/btn_subtract"  style="@style/CalcBtn.TextOnly" android:text="@string/subtract_label"   android:textColor="@color/color_operator" />

        <Button android:id="@+id/btn_1"         style="@style/CalcBtn.TextOnly" android:text="1" />
        <Button android:id="@+id/btn_2"         style="@style/CalcBtn.TextOnly" android:text="2" />
        <Button android:id="@+id/btn_3"         style="@style/CalcBtn.TextOnly" android:text="3" />
        <Button android:id="@+id/btn_add"       style="@style/CalcBtn.TextOnly" android:text="@string/add_label"   android:textColor="@color/color_operator" />

        <ImageButton android:id="@+id/btn_mode" style="@style/CalcBtn.Icon" android:src="@drawable/ic_scientific" app:tint="@color/color_operator" android:contentDescription="@string/mode_desc" />
        <Button android:id="@+id/btn_0"         style="@style/CalcBtn.TextOnly" android:text="0" />
        <Button android:id="@+id/btn_decimal"   style="@style/CalcBtn.TextOnly" android:text="@string/decimal_label" />
        <Button android:id="@+id/btn_equals"    style="@style/CalcBtn.Equals"   android:text="@string/equals_label" />

    </GridLayout>

</LinearLayout>